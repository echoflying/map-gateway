# =============================================================
# map-gateway environment template — PLACEHOLDERS ONLY.
# Do NOT put real secrets here. Copy to `.env` and fill in:
#   cp .env.example .env && $EDITOR .env
# `.env` is git-ignored and read at startup (MAP_ENV_FILE).
# =============================================================

# Required: Tianditu (天地图) WMTS key. Kept server-side only.
# The gateway never exposes it over HTTP and never logs it.
TIANDITU_KEY=__FILL_IN_TIANDITU_KEY__

# Optional access control. Enable only when BOTH values are configured on Raven.
# MAP_ACCESS_TOKEN_SECRET stays on Raven only (at least 32 random bytes).
# MAP_TOKEN_ISSUER_KEY is a separate long-lived key shared only with trusted
# server backends that call POST /auth/token (for example piboy.xyz backend).
# Never embed either value in browser JavaScript, HTML, or mobile clients.
#MAP_ACCESS_TOKEN_SECRET=__FILL_IN_64_HEX_CHARS__
#MAP_TOKEN_ISSUER_KEY=__FILL_IN_64_HEX_CHARS__

# Required by reverse geocoding (and /resolve/candidates): bundled, checksummed
# four-level China administrative catalog. Codes/names returned to callers are
# canonicalized against this file instead of trusting unvalidated upstream text.
#MAP_ADMIN_DIVISIONS_FILE=data/admin-divisions.tsv

# --- Optional overrides (defaults shown) ---
# Address the gateway binds to. Keep on loopback; nginx proxies from there.
#MAP_LISTEN_ADDR=127.0.0.1:8082
# Disk cache directory (created on start; bounded by MAP_CACHE_MAX_MB).
#MAP_CACHE_DIR=/home/piboy/projects/map-gateway/cache
# Cache size cap in MiB; eviction removes oldest files down to the watermark.
#MAP_CACHE_MAX_MB=200
# Eviction watermark (fraction of max kept after eviction).
#MAP_CACHE_EVICT_WATERMARK=0.8
# Per-IP tile request rate limit (requests per minute).
#MAP_TILE_RATE=600
# Upstream fetch timeout (Go duration, e.g. 45s).
#MAP_UPSTREAM_TIMEOUT=45s
# Tianditu reverse-geocoder endpoint (override only for a mirror/test server).
#MAP_GEOCODER_UPSTREAM=https://api.tianditu.gov.cn/geocoder
# Tianditu v2 search endpoint for administrative centers and nearby POIs.
#MAP_SEARCH_UPSTREAM=https://api.tianditu.gov.cn/v2/search
# Optional path of the env file to load (default: ./.env). Empty disables.
#MAP_ENV_FILE=.env
