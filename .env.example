# =============================================================
# map-gateway environment template — PLACEHOLDERS ONLY.
# Do NOT put real secrets here. Copy to `.env` and fill in:
#   cp .env.example .env && $EDITOR .env
# `.env` is git-ignored and read at startup (MAP_ENV_FILE).
# =============================================================

# Required: Tianditu (天地图) WMTS key. Kept server-side only.
# The gateway never exposes it over HTTP and never logs it.
TIANDITU_KEY=__FILL_IN_TIANDITU_KEY__

# --- Optional overrides (defaults shown) ---
# Address the gateway binds to. Keep on loopback; nginx proxies from there.
#MAP_LISTEN_ADDR=127.0.0.1:8082
# Disk cache directory (created on start; bounded by MAP_CACHE_MAX_MB).
#MAP_CACHE_DIR=/home/piboy/projects/map-gateway/cache
# Cache size cap in MiB; eviction removes oldest files down to the watermark.
#MAP_CACHE_MAX_MB=200
# Eviction watermark (fraction of max kept after eviction).
#MAP_CACHE_EVICT_WATERMARK=0.8
# Per-IP tile request rate limit (requests per minute).
#MAP_TILE_RATE=600
# Upstream fetch timeout (Go duration, e.g. 45s).
#MAP_UPSTREAM_TIMEOUT=45s
# Optional path of the env file to load (default: ./.env). Empty disables.
#MAP_ENV_FILE=.env
